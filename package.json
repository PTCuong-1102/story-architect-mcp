{
  "name": "story-architect-mcp",
  "version": "0.1.0",
  "description": "A Model Context Protocol (MCP) Server for AI-assisted long-form fiction writing, worldbuilding, continuity auditing, and novel architecture.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "story-architect-mcp": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PTCuong-1102/story-architect-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "novel",
    "writing",
    "story",
    "worldbuilding",
    "fiction",
    "ai",
    "claude",
    "cursor"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "setup": "node dist/index.js setup",
    "doctor": "node dist/index.js doctor",
    "init-novel": "node dist/index.js init-novel",
    "test": "tsx --test test/*.test.ts",
    "prepare": "npm run build"
  },
  "files": [
    "dist",
    "scripts",
    ".agents"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "glob": "^11.0.0",
    "gray-matter": "^4.0.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.5",
    "typescript": "^5.7.0"
  }
}
